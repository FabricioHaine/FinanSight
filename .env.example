# =============================================================================
# FinanSight - variaveis de ambiente
# Copie este arquivo para .env e ajuste os valores conforme sua maquina.
# NUNCA comite o arquivo .env com credenciais reais.
# =============================================================================

# --- Back-end ---------------------------------------------------------------
# Porta da API
SERVER_PORT=8080

# Banco de dados PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/finansight
DB_USER=finansight
DB_PASSWORD=finansight

# Segredo usado para assinar os tokens JWT.
# Gere um valor forte, por exemplo: openssl rand -base64 48
FINANSIGHT_JWT_SECRET=troque-este-valor-por-um-segredo-longo-e-aleatorio

# Validade do token JWT em minutos (padrao: 720 = 12 horas)
FINANSIGHT_JWT_EXPIRATION_MINUTES=720

# Origens autorizadas para o front-end (separadas por virgula)
FINANSIGHT_ALLOWED_ORIGINS=http://localhost:4200

# Cria a conta de demonstracao (demo@finansight.app / demo1234) ao iniciar.
# Mantenha false em producao.
FINANSIGHT_DEMO_ENABLED=true

# --- Front-end --------------------------------------------------------------
# Endereco do back-end usado pelo proxy de desenvolvimento
PROXY_TARGET=http://localhost:8080
